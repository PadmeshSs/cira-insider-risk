# ============================================================
# CIRA — Context-Aware Insider Risk Analytics
# Environment Configuration Template
# ============================================================
#
# Copy this file to `.env` and fill in real values.
# `.env` must NEVER be committed to Git (already covered by .gitignore).
#
# Variables are grouped by:
#   [FYP CORE]              required for the mandatory vertical slice
#   [PRODUCTION EXTENSION]  not required until the corresponding
#                           component (Kafka, Redis, Celery,
#                           OpenSearch, etc.) is actually implemented.
#                           Left commented out — uncommenting alone
#                           does not mean the component is IMPLEMENTED.
#
# Reference: CIRA_FINAL_ARCHITECTURE.md §43 (Configuration)
# ============================================================


# ------------------------------------------------------------
# Core application  [FYP CORE]
# ------------------------------------------------------------

# PostgreSQL connection string (async driver — SQLAlchemy 2.x async + asyncpg)
DATABASE_URL=postgresql+asyncpg://cira:changeme@localhost:5433/insider_threat_db

# JWT / session signing secret — generate with: openssl rand -hex 32
SECRET_KEY=changeme-generate-a-real-secret

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------
# ML model serving  [FYP CORE]
# ------------------------------------------------------------

# Path to the TabNet model artifact directory (models/saved_models/)
MODEL_PATH=./models/saved_models

# Pinned model version tag to load at inference time
MODEL_VERSION=v0.1.0


# ------------------------------------------------------------
# CRI — Contextual Risk Intelligence  [FYP CORE]
# Placeholder defaults only — not tuned/final values. Weights and
# thresholds are configuration, not a hard-coded formula (§15/§47 rule 14).
# ------------------------------------------------------------

CRI_WEIGHT_ANOMALY_SCORE=0.40
CRI_WEIGHT_USER_CONTEXT=0.15
CRI_WEIGHT_ASSET_CRITICALITY=0.15
CRI_WEIGHT_HISTORICAL_DEVIATION=0.15
CRI_WEIGHT_PEER_DEVIATION=0.05
CRI_WEIGHT_MITRE_CONTEXT=0.10

# Severity band thresholds on the normalized 0-100 CRI score
CRI_SEVERITY_LOW_MAX=24
CRI_SEVERITY_MEDIUM_MAX=49
CRI_SEVERITY_HIGH_MAX=74
# 75-100 = CRITICAL (implicit top band)


# ------------------------------------------------------------
# MITRE ATT&CK enrichment  [FYP CORE]
# ------------------------------------------------------------

# Pinned enterprise-attack STIX bundle version (reproducibility)
MITRE_ATTACK_VERSION=15.1

# Local path to the materialized STIX bundle / technique lookup table
MITRE_STIX_BUNDLE_PATH=./data/mitre/enterprise-attack.json

# Minimum confidence for a technique match to be reported instead of
# marked "unmapped" (implementation-defined scale, e.g. 0.0-1.0)
MITRE_MAPPING_CONFIDENCE_THRESHOLD=0.6


# ============================================================
# PRODUCTION EXTENSIONS — commented out
# Uncomment only when the corresponding component is actually being
# implemented (Chapter 17/18). Not part of the FYP core.
# ============================================================

# Redis — cache / temporary state only, never the source of truth
# REDIS_URL=redis://localhost:6379/0

# Kafka — production event-streaming backbone
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenSearch — large-scale event search/investigation
# OPENSEARCH_URL=https://localhost:9200

# Celery — async heavy workloads (SHAP batches, retraining, reports).
# Must never sit on the real-time Kafka -> TabNet path.
# CELERY_BROKER_URL=redis://localhost:6379/1

# CORS — allowed frontend origins (comma-separated). Note: grouped here
# per the current spec, but in practice this is usually needed as soon
# as the React frontend calls FastAPI from a different origin (Chapter
# 13/14) — earlier than the other items in this section.
# CORS_ORIGINS=http://localhost:5173
