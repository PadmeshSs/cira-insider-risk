# ============================================================
# CIRA — Context-Aware Insider Risk Analytics
# Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Core application  [FYP CORE]
# ------------------------------------------------------------

# PostgreSQL credentials
POSTGRES_PASSWORD=changeme

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://cira:changeme@localhost:5433/insider_threat_db

# JWT signing secret (Chapter 13). The API refuses to issue tokens while this
# is unset, shorter than 32 characters or still this placeholder. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-secret
# Lifetime of an analyst's access token, in minutes.
ACCESS_TOKEN_MINUTES=60
# Browser origins allowed to call the API (the Chapter 14 dashboard).
CORS_ORIGINS=http://localhost:5173

# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# CERT r4.2 dataset contract
# ------------------------------------------------------------
# On the development machine these point at D:/CIRA_dataset/... (HCEA R5).
CERT_RAW_DIR=./datasets/raw/cert_r4.2
CERT_GROUND_TRUTH_DIR=./datasets/ground_truth/cert_r4.2
CERT_PROCESSED_DIR=./datasets/processed
CERT_SOURCE_TIMEZONE=UTC
CERT_TARGET_TIMEZONE=UTC

# ------------------------------------------------------------
# Execution budget (HCEA v1.0 §17)  [FYP CORE]
# ------------------------------------------------------------
# dev | mid | full
CIRA_PROFILE=dev
CIRA_MAX_WORKERS=6
CIRA_CHUNK_ROWS=500000
CIRA_MAX_RSS_GB=20
# auto | cpu | cuda
CIRA_DEVICE=auto
CIRA_SEED=42


# ------------------------------------------------------------
# ML model serving  [FYP CORE]
# ------------------------------------------------------------

MODEL_PATH=./models/saved_models
# Not read by the scoring service: the served model is a pinned registry
# version from the Chapter 8 decision file (CARRY_FORWARD N21, N28).
MODEL_VERSION=v0.1.0
# Decision written by `python -m app.scoring.select` (default:
# experiments/chapter8_serving_decision.json).
# CIRA_SERVING_DECISION=./experiments/chapter8_serving_decision.json
# Rollback / testing only: pin the served model without a new decision.
# Shows up as source "env" in /health and in the batch runlog.
# CIRA_SERVED_MODEL=tabnet:v0005
# CIRA_SHADOW_MODEL=gbdt:v0001


# ------------------------------------------------------------
# CRI — Contextual Risk Intelligence  [FYP CORE]  (Chapter 9)
# ------------------------------------------------------------
# These equal the defaults in backend/app/cri/config.py, set before any CRI
# number existed (N37). Any value that differs is reported as an override,
# written into the risk run's meta and flagged by verify_chapter9.py.
# Weights are renormalised over the components that are available.

CRI_WEIGHT_ANOMALY_SCORE=0.60
CRI_WEIGHT_HISTORICAL_DEVIATION=0.15
CRI_WEIGHT_PEER_DEVIATION=0.10
CRI_WEIGHT_USER_CONTEXT=0.05
CRI_WEIGHT_MITRE_CONTEXT=0.10
# CERT r4.2 has no asset inventory or criticality source; the component is
# excluded, never synthesised (N9, N35). Set only with a real inventory.
CRI_WEIGHT_ASSET_CRITICALITY=0.00

# Upper integer of LOW, MEDIUM, HIGH; CRITICAL is 75-100.
CRI_SEVERITY_LOW_MAX=24
CRI_SEVERITY_MEDIUM_MAX=49
CRI_SEVERITY_HIGH_MAX=74

# LDAP roles treated as privileged (user_context = 1). See N36.
CRI_PRIVILEGED_ROLES=ITAdmin
# Rarity scale: 1.0 = rarer than 1 in 10**D reference user-days. Part of the
# calibration's definition; changing it means refitting.
CRI_RARITY_DECADES=5
# Ablations only (Chapter 16), comma-separated component names.
# CRI_DISABLED_COMPONENTS=
# Calibration pin written by `python -m app.cri.calibrate`
# (default: experiments/chapter9_cri_calibration.json).
# CIRA_CRI_CALIBRATION=./experiments/chapter9_cri_calibration.json


# ------------------------------------------------------------
# MITRE ATT&CK enrichment  [FYP CORE]  (Chapter 10)
# ------------------------------------------------------------
# The version is pinned in backend/app/mitre/techniques.py together with the
# bundle's sha256 (C10-1). If this is set it must equal the pin; an old .env
# still saying 15.1 is refused rather than silently using another table.
MITRE_ATTACK_VERSION=19.2
# The bundle is read once, offline, by `python -m app.mitre.stix_loader`;
# nothing at runtime reads it. Gitignored under datasets/raw/.
MITRE_STIX_BUNDLE_PATH=./datasets/raw/mitre/enterprise-attack-19.2.json
# Reference pin written by `python -m app.mitre.calibrate`
# (default: experiments/chapter10_mitre_reference.json).
# CIRA_MITRE_REFERENCE=./experiments/chapter10_mitre_reference.json
# The Chapter 1 placeholder MITRE_MAPPING_CONFIDENCE_THRESHOLD=0.6 is gone:
# rules fire on observed behaviour and are graded by rarity, not by a
# confidence cut-off nobody validated (C10-2).


# ------------------------------------------------------------
# Explainability  [FYP CORE]  (Chapter 11)
# ------------------------------------------------------------
# No settings here. The explainer follows the served model (N30): TreeSHAP for
# XGBoost, masks for TabNet. KernelSHAP settings (bounded set, background size,
# nsamples) are command-line flags of `python -m app.explainability.batch`,
# recorded in every run's explain_meta.json, so a .env value can never change
# an explanation silently. CIRA_SEED seeds the KernelSHAP background.


# ------------------------------------------------------------
# Alerts  [FYP CORE]  (Chapter 12)
# ------------------------------------------------------------
# No settings here either. The alert policy c12-alert-policy-v1 (bands,
# daily top-k, queue ordering, correlation gap, span cap, cooldown) and the
# demo sample c12-demo-sample-v1 are command-line flags of
# `python -m app.alerts.batch`, recorded with their hash in alert_meta.json
# and in the configurations table when a run is loaded. CIRA_SEED breaks
# ties in the daily top-k. `python -m app.alerts.load` writes to DATABASE_URL
# above (or --database-url) in one transaction.


# ------------------------------------------------------------
# API  [FYP CORE]  (Chapter 13)
# ------------------------------------------------------------
# No settings beyond SECRET_KEY, ACCESS_TOKEN_MINUTES and CORS_ORIGINS above.
# Analyst accounts are created from the command line, never over HTTP:
#   python -m app.services.accounts create --username alice --email alice@example.org
# The page-size cap (200) is fixed in app/services/common.py (HCEA §13).


# ============================================================
# PRODUCTION EXTENSIONS
# ============================================================

# REDIS_URL=redis://localhost:6379/0
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# OPENSEARCH_URL=https://localhost:9200
# CELERY_BROKER_URL=redis://localhost:6379/1
