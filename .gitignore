# ============================================================
# CIRA - Context-Aware Insider Risk Analytics
# ============================================================

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.env

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ------------------------------------------------------------
# Node / React / Vite
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
build/
.vite/

# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# CIRA datasets
# ------------------------------------------------------------

# Raw/private datasets
datasets/raw/*
!datasets/raw/.gitkeep

# Processed/generated datasets
datasets/processed/*
!datasets/processed/.gitkeep

# Generated exports
datasets/exports/
*.csv
*.parquet
*.feather

# ------------------------------------------------------------
# Machine Learning
# ------------------------------------------------------------

# Trained models / checkpoints
models/saved_models/*
models/checkpoints/*
models/artifacts/*

!models/saved_models/.gitkeep
!models/checkpoints/.gitkeep
!models/artifacts/.gitkeep

# Large ML files
*.pt
*.pth
*.ckpt
*.onnx
*.joblib
*.pkl

# TensorBoard
runs/
tensorboard/
wandb/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
backend/logs/
frontend/logs/

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Local database files
*.db
*.sqlite
*.sqlite3

# PostgreSQL dumps / backups
*.dump
*.sql.gz
*.backup

# NOTE:
# Alembic migration files SHOULD be committed.
# Do NOT ignore:
# backend/alembic/
# backend/alembic/versions/

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------

# Docker local overrides
docker-compose.override.yml

# ------------------------------------------------------------
# Temporary files
# ------------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~

tmp/
temp/

# ------------------------------------------------------------
# Generated reports / experiments
# ------------------------------------------------------------
experiments/results/
experiments/outputs/
reports/generated/

# Keep directory placeholders
!experiments/results/.gitkeep
!experiments/outputs/.gitkeep
!reports/generated/.gitkeep