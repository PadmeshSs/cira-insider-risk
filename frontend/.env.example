# Base URL of the Chapter 13 API as the browser reaches it. Default when unset:
# http://localhost:8000/api/v1 (uvicorn locally, or the backend port published by docker-compose).
# The backend's CORS_ORIGINS must include the dashboard's origin (default http://localhost:5173).
VITE_API_BASE_URL=http://localhost:8000/api/v1
